$(eval $(call addlib,apprhealstonebenchmark))
CINCLUDES-y += -I$(APPRHEALSTONEBENCHMARK_BASE)/include
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/main.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/clock.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(wildcard $(APPRHEALSTONEBENCHMARK_BASE)/src/*.c)
APPRHEALSTONEBENCHMARK_SRCS-y += $(wildcard $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/*.c)
